# scripts/*.js dotenv OKUMAZ — bu değerleri yerel testte kabuğa export edin
# (ör. `export $(grep -v '^#' .env | xargs)` veya doğrudan terminale yazın)
# ya da GitHub Actions'da repo Secrets olarak tanımlayın.

ELEVENLABS_API_KEY=
# Opsiyonel — boş bırakılırsa George (JBFqnCBsd6RMkjVDRZzb) kullanılır.
# Voice Library'deki sesler ücretsiz ElevenLabs planında API'ye kapalı;
# George gibi premade sesler ücretsiz planda da çalışır.
ELEVENLABS_VOICE_ID=

# Buffer GraphQL API anahtarı (Buffer → Settings → API). Eski REST API'nin
# "access token"ı DEĞİL — o API 1 Şubat 2027'de kapanıyor ve yeni
# anahtarlar zaten sadece GraphQL API'de çalışıyor.
BUFFER_ACCESS_TOKEN=
# Opsiyonel — boş bırakılırsa bağlı Instagram kanalı otomatik bulunur.
BUFFER_CHANNEL_ID=
