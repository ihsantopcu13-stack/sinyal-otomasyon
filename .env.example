# scripts/*.js dotenv OKUMAZ — bu değerleri yerel testte kabuğa export edin
# (ör. `export $(grep -v '^#' .env | xargs)` veya doğrudan terminale yazın)
# ya da GitHub Actions'da repo Secrets olarak tanımlayın.

ELEVENLABS_API_KEY=
# Hesabınızda Türkçe seslendirme için seçtiğiniz sesin ID'si (opsiyonel,
# boş bırakılırsa varsayılan multilingual bir ses kullanılır)
ELEVENLABS_VOICE_ID=

BUFFER_ACCESS_TOKEN=
BUFFER_CHANNEL_ID=
